{
  "expo": {
    "name": "ServisApp Personel",
    "slug": "servisapp-crew",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "servisapp-crew",
    "plugins": [
      "expo-font",
      "expo-task-manager",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sefer sırasında aracın konumunu velilere göstermek için konum gerekir.",
          "locationAlwaysAndWhenInUsePermission": "Sefer arka plandayken konum göndermek için konum gerekir.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.servisapp.crew",
      "infoPlist": {
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "app.servisapp.crew",
      "adaptiveIcon": {
        "backgroundColor": "#EEF1F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "backgroundColor": "#EEF1F5"
    }
  }
}
