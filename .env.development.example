# Yerel geliştirme — docker compose up -d ile ayağa kalkan Postgres'e bağlanır.
# Kopyala:  cp .env.development.example .env
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/servisapp
DATABASE_URL=postgresql://servisapp_api:yerel-gelistirme-parolasi@127.0.0.1:54322/servisapp
WORKER_DATABASE_URL=postgresql://servisapp_worker:yerel-gelistirme-parolasi@127.0.0.1:54322/servisapp

API_DB_PASSWORD=yerel-gelistirme-parolasi
WORKER_DB_PASSWORD=yerel-gelistirme-parolasi

SUPABASE_URL=https://yerel.supabase.co
SUPABASE_JWT_SECRET=yerel-gelistirme-jwt-secret-degeri

OTP_PEPPER=yerel-gelistirme-pepper-en-az-otuziki-karakter
OTP_ENCRYPTION_KEY=yerel-gelistirme-anahtari-en-az-otuziki-kr

EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
EXPO_PUBLIC_SUPABASE_URL=https://yerel.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=https://yerel.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

ADMIN_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

# Yerel personel uygulaması (hosted Auth yokken). Üretimde boş bırak.
DEV_LOGIN_PASSWORD=yerel-personel-giris-parolasi
GOOGLE_MAPS_API_KEY=

# Yalnız IP/CIDR. `true` veya hop-count (sayı) verilmez — XFF sahteciliği.
TRUST_PROXY=

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
