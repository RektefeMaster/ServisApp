# ─── Ortam ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# ─── Veritabanı (Supabase Postgres) ───────────────────────────────────────
# API istek yolu: transaction pooler + kısıtlı rol (BYPASSRLS YOK)
# Pooler kullanıcı adı: ROL.PROJE_REF  (ör. servisapp_api.abcdefghijklmnop)
DATABASE_URL=postgresql://servisapp_api.PROJE_REF:PAROLA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
# pg-boss LISTEN/NOTIFY kullanır: session pooler (5432). Transaction pooler (6543) LISTEN taşımaz.
WORKER_DATABASE_URL=postgresql://servisapp_worker.PROJE_REF:PAROLA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
# Migration/deploy: doğrudan bağlantı (pooler DEĞİL). Hosted şema MCP apply_migration ile basıldı;
# pnpm db:migrate'i hosted'a çalıştırma — 0001 tekrar CREATE eder.
MIGRATION_DATABASE_URL=postgresql://postgres:PAROLA@db.PROJE_REF.supabase.co:5432/postgres?sslmode=require

# ─── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://PROJE.supabase.co
SUPABASE_ANON_KEY=
# JWT doğrulaması: proje ES256/JWKS kullanıyorsa BOŞ bırak.
# Rastgele bir HS256 secret uydurma — sahte HS256 jetonları kabul edilir.
# Yalnız legacy HS256 (yerel docker / eski JWT secret) için doldur.
# service_role anahtarı API'de KULLANILMAZ (RLS'i bypass eder)
SUPABASE_JWT_SECRET=

# ─── Kriptografi (asla DB'ye taşınmaz) ────────────────────────────────────
# OTP HMAC pepper — 32+ byte rastgele: openssl rand -base64 48
OTP_PEPPER=
# OTP ciphertext anahtarı (yeniden gönderim için) — 32 byte base64
OTP_ENCRYPTION_KEY=

# ─── Dış servisler ────────────────────────────────────────────────────────
# Sefer baseline / refresh. Boşsa haversine + sequential chunk yolu kullanılır.
GOOGLE_MAPS_API_KEY=
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=

# ─── İstemciler (Auth + API; service_role YOK) ────────────────────────────
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
EXPO_PUBLIC_SUPABASE_URL=https://PROJE.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=https://PROJE.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Yönetim paneli tarayıcı origin'leri (virgülle). Mobil CORS kullanmaz.
ADMIN_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
# Davet linkinin kökü (üretimde panel URL). Boşsa API göreli /i/:token döner.
ADMIN_PUBLIC_URL=http://127.0.0.1:3001

# Yerel personel girişi (hosted Auth yokken). Üretimde boş bırak.
DEV_LOGIN_PASSWORD=

# ─── Gözlemlenebilirlik ───────────────────────────────────────────────────
SENTRY_DSN=
# OTel exporter sonra bağlanır; boşsa no-op iskelet kalır.
OTEL_EXPORTER_OTLP_ENDPOINT=
